<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.Views.HistoriquePage"
             Title="Historique">

    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Derniers calculs" FontSize="18" FontAttributes="Bold"/>
        <CollectionView ItemsSource="{Binding Items}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" FontSize="14"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Label Text="Aucun calcul pour l'instant" FontSize="14" Opacity="0.6"/>
            </CollectionView.EmptyView>
        </CollectionView>
        <Button Text="Effacer l'historique"
                Command="{Binding EffacerHistoriqueCommand}"/>
        <Button Text="Retour"
                Command="{Binding RetourCommand}"/>
    </VerticalStackLayout>

</ContentPage>
