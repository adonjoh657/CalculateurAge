<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculateurAge.MainPage"
             Title="Calculateur">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nom" FontSize="16"/>
            <Entry Text="{Binding Nom, Mode=TwoWay}"
                   Placeholder="Votre nom"/>
            <Label Text="Date de naissance" FontSize="16"/>
            <DatePicker Date="{Binding DateNaissance, Mode=TwoWay}"/>
            <Button Text="Calculer"
                    Command="{Binding CalculerCommand}"/>
            <Button Text="Effacer"
                    Command="{Binding EffacerCommand}"/>
            <Label Text="Historique" FontSize="16" FontAttributes="Bold"/>
            <CollectionView ItemsSource="{Binding Historique}"
                            MaximumHeightRequest="150">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Label Text="{Binding .}" FontSize="14"/>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="Aucun calcul pour l'instant" FontSize="14" Opacity="0.6"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <Button Text="Effacer l'historique"
                    Command="{Binding EffacerHistoriqueCommand}"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
